.DS_Store

# SwiftPM build output. .build/workspace-state.json in particular looks like
# configuration and is not; it was committed once already.
.build/
.swiftpm/

# Package.resolved is not committed: this package has no external dependencies,
# so the file records nothing but its own name and would be pure noise in diffs.
Package.resolved

# Generated by xcodegen from project.yml, which is the source. A committed
# pbxproj is thousands of lines of UUIDs nobody reviews.
*.xcodeproj/

# Carries DEVELOPMENT_TEAM, which is personal. Signing.xcconfig holds the shared
# half and includes this one when it exists.
Local.xcconfig
